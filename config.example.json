{
 "listen": ":8098",
 "issuer": "https://bits.example.org",
 "audience": "example-site/store",
 "max_lifetime": "168h",
 "url_lifetime": "5m",
 "keys": {
  "console-1": {"x": "<base64url raw Ed25519 public key>", "signer": "user"},
  "orch-1": {"x": "<base64url raw Ed25519 public key>", "signer": "build"}
 },
 "volumes": {
  "cern-s3": {"endpoint": "https://s3.cern.ch", "bucket": "lcgapp-bits-testing", "region": "us-east-1",
              "access_key_env": "BITS_STORE_S3_ACCESS_KEY", "secret_key_env": "BITS_STORE_S3_SECRET_KEY"}
 },
 "fetch": {"site_ranges": ["137.138.0.0/16", "128.141.0.0/16", "128.142.0.0/16", "188.184.0.0/15", "2001:1458::/32"],
           "site_hosts": ["gitlab.cern.ch", "lcgpackages.web.cern.ch"],
           "trusted": ["cern.ch", "github.com", "gitlab.com", "gnu.org", "pypi.org", "pythonhosted.org"]},
 "bindings": [
  {"prefix": "/MANIFESTS", "volume": "cern-s3", "key_prefix": "MANIFESTS", "format": "manifests", "public": true},
  {"prefix": "/store", "volume": "cern-s3", "key_prefix": "TARS", "format": "tarballs", "public": true},
  {"prefix": "/sources/archives", "volume": "cern-s3", "key_prefix": "SOURCES/cache", "format": "sources",
   "public": true, "max_size": 34359738368}
 ]
}
