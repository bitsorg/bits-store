{
 "listen": ":8098",
 "issuer": "https://bits.example.org",
 "audience": "example-site/store",
 "max_lifetime": "168h",
 "url_lifetime": "5m",
 "keys": {
  "console-1": {"x": "<base64url raw Ed25519 public key>", "signer": "user"},
  "orch-1": {"x": "<base64url raw Ed25519 public key>", "signer": "build"}
 },
 "volumes": {
  "cern-s3": {"endpoint": "https://s3.cern.ch", "bucket": "lcgapp-bits-testing", "region": "us-east-1",
              "access_key_env": "BITS_STORE_S3_ACCESS_KEY", "secret_key_env": "BITS_STORE_S3_SECRET_KEY"},
  "cern-s3-public": {"endpoint": "https://s3.cern.ch", "bucket": "lcgapp-bits-public", "region": "us-east-1"}
 },
 "bindings": [
  {"prefix": "/manifests", "volume": "cern-s3-public", "key_prefix": "MANIFESTS", "public": true},
  {"prefix": "/sources/archives", "volume": "cern-s3", "key_prefix": "SOURCES/cache"}
 ]
}
